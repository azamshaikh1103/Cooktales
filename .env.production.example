# Domain names. Point both DNS records to the EC2 server before starting Caddy.
DOMAIN=www.example.com
API_DOMAIN=api.example.com

# Browser-facing API address. This value is included in the frontend build.
NEXT_PUBLIC_API_URL=https://api.example.com/api/v1

# PostgreSQL. Use long, unique values; never commit the real .env.production file.
POSTGRES_DB=cooktale
POSTGRES_USER=cooktale
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://cooktale:replace-with-a-long-random-password@postgres:5432/cooktale

# Redis is internal-only. Keep the password in DATABASE_URL-style secrets, not Git.
REDIS_URL=redis://redis:6379/0

NODE_ENV=production
APP_MODE=api
PORT=4000
API_PREFIX=api
API_VERSION=1
FRONTEND_URL=https://www.example.com
CORS_ORIGINS=https://www.example.com,https://example.com
AUTH_TRUSTED_ORIGINS=https://www.example.com,https://example.com
AUTH_CSRF_PROTECTION_ENABLED=true

JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30
EMAIL_UNSUBSCRIBE_SECRET=replace-with-a-long-random-secret

# Copy the remaining provider settings from backend/.env.example and fill them in
# only on the server: Cloudinary, Google, Resend, VAPID and Lemon Squeezy.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_ROOT_FOLDER=cooktale
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=https://api.example.com/api/v1/auth/google/callback
RESEND_API_KEY=
EMAIL_FROM=CookTale <noreply@example.com>
CONTACT_EMAIL_TO=contact@example.com
VAPID_SUBJECT=mailto:hello@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_VARIANT_MONTHLY=
LEMONSQUEEZY_VARIANT_YEARLY=
LEMONSQUEEZY_VARIANT_LIFETIME=
