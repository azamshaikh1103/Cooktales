# Staging is isolated from production. Generate every secret on the staging
# server and never copy .env.production or a production database into it.
DOMAIN=staging.cooktale.in
API_DOMAIN=api.staging.cooktale.in
CADDYFILE=./deploy/Caddyfile.staging
NEXT_PUBLIC_API_URL=https://api.staging.cooktale.in/api/v1

POSTGRES_DB=cooktale_staging
POSTGRES_USER=cooktale_staging
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://cooktale_staging:replace-with-a-long-random-password@postgres:5432/cooktale_staging
REDIS_URL=redis://redis:6379/0

NODE_ENV=production
APP_MODE=api
PORT=4000
API_PREFIX=api
API_VERSION=1
FRONTEND_URL=https://staging.cooktale.in
CORS_ORIGINS=https://staging.cooktale.in
AUTH_TRUSTED_ORIGINS=https://staging.cooktale.in
AUTH_CSRF_PROTECTION_ENABLED=true

JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30
EMAIL_UNSUBSCRIBE_SECRET=replace-with-a-long-random-secret

# Use only provider test credentials. Keep email, payouts, and live webhooks off.
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
CLOUDFLARE_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=https://api.staging.cooktale.in/api/v1/auth/google/callback
RESEND_API_KEY=
EMAIL_FROM=CookTale Staging <noreply@staging.cooktale.in>
CONTACT_EMAIL_TO=
NOTIFICATION_EMAIL_DIGEST_ENABLED=false
NOTIFICATION_PUSH_ENABLED=false
VAPID_SUBJECT=mailto:hello@staging.cooktale.in
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
PUSH_ALLOWED_HOSTS=fcm.googleapis.com,updates.push.services.mozilla.com,.push.apple.com,.notify.windows.com
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_VARIANT_MONTHLY=
LEMONSQUEEZY_VARIANT_YEARLY=
LEMONSQUEEZY_VARIANT_LIFETIME=
