{
  "name": "@cooktale/backend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "prisma:generate": "prisma generate",
    "test": "npm run test:unit",
    "test:unit": "jest --config test/jest-unit.json --runInBand",
    "test:integration": "jest --config test/jest-integration.json --runInBand",
    "test:e2e": "jest --config test/jest-e2e.json --runInBand",
    "test:api": "npm run test:infra:up && (npm run test:api:run; status=$?; npm run test:infra:down; exit $status)",
    "test:api:run": "npm run test:prepare && npm run test:integration && npm run test:e2e",
    "test:auth": "npm run test:api",
    "test:all": "npm run test:docker",
    "test:all:container": "npm run test:unit && npm run test:prepare && npm run test:integration && npm run test:e2e",
    "test:docker": "docker compose -f ../docker-compose.yml --profile test run --rm --build backend-test",
    "test:coverage": "jest --config test/jest-unit.json --runInBand --coverage",
    "import:legacy-content": "node --env-file=.env scripts/import-public-cooktale-content.mjs",
    "seed:local-story-covers": "node --env-file=.env scripts/populate-local-story-covers.mjs",
    "seed:local-recipe-images": "node --env-file=.env scripts/populate-local-recipe-images.mjs",
    "seed:local-sample-content": "node --env-file=.env scripts/seed-local-sample-content.mjs",
    "seed:local-ui-preview": "node --env-file=.env scripts/seed-local-ui-preview.mjs",
    "seed:local-sample-discussions": "node --env-file=.env scripts/seed-local-sample-discussions.mjs",
    "test:infra:up": "docker compose -f ../docker-compose.yml --profile test up -d --wait postgres-test redis-test",
    "test:infra:down": "docker compose -f ../docker-compose.yml --profile test stop postgres-test redis-test",
    "test:prepare": "DATABASE_URL=${DATABASE_URL:-postgresql://cooktale_test:cooktale_test@127.0.0.1:5433/cooktale_test} REDIS_URL=${REDIS_URL:-redis://127.0.0.1:6380/0} npx prisma migrate reset --force --skip-seed --skip-generate"
  },
  "dependencies": {
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.28",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "11.1.28",
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.79.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cloudinary": "^2.10.0",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.0.0",
    "ioredis": "^5.11.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "web-push": "^3.6.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.1.28",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "29.5.14",
    "@types/node": "^20.17.10",
    "@types/supertest": "7.2.1",
    "@types/web-push": "^3.6.4",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "eslint": "^9.17.0",
    "jest": "29.7.0",
    "prettier": "^3.4.2",
    "prisma": "^6.19.0",
    "source-map-support": "^0.5.21",
    "supertest": "7.2.2",
    "ts-jest": "29.4.12",
    "typescript": "^5.7.2"
  }
}
