{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": ".*\\.spec\\.ts$",
  "setupFiles": ["<rootDir>/test/setup-env.ts"],
  "transform": {
    "^.+\\.(t|j)s$": ["ts-jest", { "tsconfig": "<rootDir>/tsconfig.json" }]
  },
  "collectCoverageFrom": ["src/modules/auth/**/*.ts", "src/configure-app.ts"]
}
