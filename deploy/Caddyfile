{$DOMAIN} {
	encode zstd gzip
	reverse_proxy frontend:3000
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

{$API_DOMAIN} {
	encode zstd gzip
	reverse_proxy backend:4000 {
		header_up X-CookTale-Client-IP {http.request.header.CF-Connecting-IP}
		header_up -CF-Connecting-IP
		header_up -X-Real-IP
		header_up -X-Forwarded-For
	}
}
